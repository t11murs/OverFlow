{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "servicePorts", "commonConfig", "services"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["pullPolicy", "tag"],
      "properties": {
        "registry": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "servicePorts": {
      "type": "object",
      "required": ["application", "management"],
      "properties": {
        "application": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "management": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["image", "secretName", "replicas", "public", "resources", "autoscaling"],
        "properties": {
          "image": {"type": "string", "minLength": 1},
          "digest": {
            "type": "string",
            "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
          },
          "secretName": {"type": "string", "minLength": 1},
          "replicas": {"type": "integer", "minimum": 1},
          "public": {"type": "boolean"},
          "resources": {"type": "object"},
          "autoscaling": {
            "type": "object",
            "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
            "properties": {
              "enabled": {"type": "boolean"},
              "minReplicas": {"type": "integer", "minimum": 1},
              "maxReplicas": {"type": "integer", "minimum": 1},
              "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }
        }
      }
    }
  }
}
