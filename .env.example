# Local development values only. Copy this file to .env when overrides are needed.
IDENTITY_DB_PORT=15432
IDENTITY_DB_PASSWORD=identity_local
CATALOG_DB_PORT=15433
CATALOG_DB_PASSWORD=catalog_local
INVENTORY_DB_PORT=15434
INVENTORY_DB_PASSWORD=inventory_local
ORDER_DB_PORT=15435
ORDER_DB_PASSWORD=orders_local
PAYMENT_DB_PORT=15436
PAYMENT_DB_PASSWORD=payment_local
NOTIFICATION_DB_PORT=15437
NOTIFICATION_DB_PASSWORD=notification_local
KAFKA_PORT=9092
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_CONSUMER_RETRY_DELAY=1s
KAFKA_DLQ_SUFFIX=.dlq
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_CONNECT_TIMEOUT=1s
REDIS_TIMEOUT=1s
CATALOG_CACHE_ENABLED=true
CATALOG_PUBLIC_PRODUCT_CACHE_TTL=1m
CATALOG_PUBLIC_OFFER_CACHE_TTL=30s

# Наблюдаемость. Prometheus должен обращаться к endpoint только из внутренней сети.
MANAGEMENT_ENDPOINTS=health,info,prometheus
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_QUEUE_METRICS_REFRESH_INTERVAL=30s
LOG_FORMAT=ecs

# Local Catalog integration settings for Order and Inventory services.
CATALOG_BASE_URL=http://localhost:8082
CATALOG_CONNECT_TIMEOUT=2s
CATALOG_READ_TIMEOUT=3s
MARKETPLACE_COMMISSION_RATE=0.100000

# Параметры Inventory Service для локальной разработки.
INVENTORY_RESERVATION_TTL=15m
INVENTORY_EXPIRY_BATCH_SIZE=100
INVENTORY_EXPIRY_SCAN_DELAY=30s

# Восстановление зависших шагов саги и предел технических попыток провайдера.
ORDER_SAGA_RECOVERY_BATCH_SIZE=20
ORDER_SAGA_RECOVERY_SCAN_DELAY=30s
ORDER_SAGA_RECOVERY_STALE_AFTER=2m
PAYMENT_PROCESSING_MAX_ATTEMPTS=10

# Общие настройки JWT. Пользовательский и межсервисный секреты должны быть независимыми.
JWT_SECRET=replace-with-a-long-random-secret-before-enabling-jwt
JWT_ISSUER=identity-service
SERVICE_JWT_SECRET=replace-with-an-independent-long-random-service-secret
SERVICE_JWT_TTL=30s
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
