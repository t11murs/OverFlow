{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.local/contracts/kafka/payment-command-v1.schema.json",
  "title": "Команда Payment v1",
  "oneOf": [
    { "$ref": "#/$defs/capture" },
    { "$ref": "#/$defs/refund" }
  ],
  "$defs": {
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "customerId", "amount", "currency", "allocations"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string", "format": "uuid" },
        "amount": { "type": "string", "pattern": "^[0-9]{1,15}\\.[0-9]{4}$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sellerId", "grossAmount", "commissionAmount", "netAmount"],
            "properties": {
              "sellerId": { "type": "string", "format": "uuid" },
              "grossAmount": { "type": "string", "pattern": "^[0-9]{1,15}\\.[0-9]{4}$" },
              "commissionAmount": { "type": "string", "pattern": "^[0-9]{1,15}\\.[0-9]{4}$" },
              "netAmount": { "type": "string", "pattern": "^[0-9]{1,15}\\.[0-9]{4}$" }
            }
          }
        }
      }
    },
    "refund": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "reason"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    }
  }
}
