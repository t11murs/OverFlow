{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.local/contracts/kafka/inventory-command-v1.schema.json",
  "title": "Команда Inventory v1",
  "oneOf": [
    { "$ref": "#/$defs/reserve" },
    { "$ref": "#/$defs/orderCommand" }
  ],
  "$defs": {
    "orderCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "reason": { "type": "string", "maxLength": 255 }
      }
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "items"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["orderItemId", "offerId", "sellerId", "quantity"],
            "properties": {
              "orderItemId": { "type": "string", "format": "uuid" },
              "offerId": { "type": "string", "format": "uuid" },
              "sellerId": { "type": "string", "format": "uuid" },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 }
            }
          }
        }
      }
    }
  }
}
