{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.local/contracts/kafka/inventory-event-message-v1.schema.json",
  "title": "Полное сообщение результата Inventory v1",
  "allOf": [
    { "$ref": "event-envelope-v1.schema.json" },
    {
      "oneOf": [
        {
          "properties": {
            "eventType": { "const": "InventoryReserved" },
            "eventVersion": { "const": 1 },
            "producer": { "const": "inventory-service" },
            "payload": { "$ref": "inventory-event-v1.schema.json#/$defs/reserved" }
          }
        },
        {
          "properties": {
            "eventType": { "enum": ["InventoryRejected", "InventoryConfirmationFailed"] },
            "eventVersion": { "const": 1 },
            "producer": { "const": "inventory-service" },
            "payload": { "$ref": "inventory-event-v1.schema.json#/$defs/rejected" }
          }
        },
        {
          "properties": {
            "eventType": { "enum": ["InventoryConfirmed", "InventoryReleased"] },
            "eventVersion": { "const": 1 },
            "producer": { "const": "inventory-service" },
            "payload": { "$ref": "inventory-event-v1.schema.json#/$defs/completed" }
          }
        }
      ]
    }
  ]
}
