{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.local/contracts/kafka/inventory-event-v1.schema.json",
  "title": "Результат Inventory v1",
  "oneOf": [
    { "$ref": "#/$defs/reserved" },
    { "$ref": "#/$defs/rejected" },
    { "$ref": "#/$defs/completed" }
  ],
  "$defs": {
    "reserved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "reservationId", "expiresAt", "allocations"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "reservationId": { "type": "string", "format": "uuid" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["orderItemId", "warehouseId", "offerId", "sellerId", "quantity"],
            "properties": {
              "orderItemId": { "type": "string", "format": "uuid" },
              "warehouseId": { "type": "string", "format": "uuid" },
              "offerId": { "type": "string", "format": "uuid" },
              "sellerId": { "type": "string", "format": "uuid" },
              "quantity": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "code"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "code": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "reservationId"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "reservationId": { "type": "string", "format": "uuid" }
      }
    }
  }
}
