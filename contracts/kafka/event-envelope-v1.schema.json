{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.local/contracts/kafka/event-envelope-v1.schema.json",
  "title": "Конверт интеграционного сообщения OrderFlow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "minLength": 1, "maxLength": 160 },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "traceId": { "type": ["string", "null"], "maxLength": 128 },
    "payload": { "type": "object" }
  }
}
